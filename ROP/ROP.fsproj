<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion Condition="'$(TargetFramework)' == 'net8.0'">8.0</LangVersion>
    <LangVersion Condition="'$(TargetFramework)' == 'net10.0'">10.0</LangVersion>
    <Authors>Gian-Luca ANFOSSI</Authors>
    <Company>Ganfoss</Company>
    <PackageId>Ganfoss.ROP</PackageId>
    <Version>1.2.0</Version>
    <Description>An F# library implementing Railway-Oriented Programming around a custom Returns type that tracks warnings alongside success values.</Description>
    <PackageTags>fsharp;railway-oriented-programming;functional;validation;result</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/GianFossi/ROP</PackageProjectUrl>
    <RepositoryUrl>https://github.com/GianFossi/ROP</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="ROP.ico" />
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <Compile Include="Option.Extension.fs" />
    <Compile Include="Choice.Extension.fs" />
    <Compile Include="Result.Extension.fs" />
    <Compile Include="Returns.fs" />
    <Compile Include="Testing.fs" />
    <None Include="ROP.ico">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="Validate %28OBSOLETE%29.fs" />
    <Compile Include="Validation.fs" />
    <None Include="Example.Result.fsx" />
    <None Include="Examples.Returns.General.fsx" />
    <None Include="Examples.Returns.Validation.Series.fsx" />
    <None Include="Examples.Returns.Validation.Parallel.1.fsx" />
    <None Include="Examples.Returns.Validation.Parallel.2.fsx" />
    <None Include="Script5.fsx" />
    <None Include="Script6.fsx" />
    <None Include="Script7.fsx" />
    <None Include="Examples.Returns.HeatExchanger.fsx" />
  </ItemGroup>
</Project>