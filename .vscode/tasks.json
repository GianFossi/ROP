{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (Release)",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/ROP.sln",
                "--configuration",
                "Release"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Pack (NuGet)",
            "type": "process",
            "command": "dotnet",
            "args": [
                "pack",
                "${workspaceFolder}/ROP/ROP.fsproj",
                "--configuration",
                "Release",
                "--output",
                "${workspaceFolder}/nupkgs"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "Publish (DLL net8.0)",
            "type": "process",
            "command": "dotnet",
            "args": [
                "publish",
                "${workspaceFolder}/ROP/ROP.fsproj",
                "--configuration",
                "Release",
                "--framework",
                "net8.0",
                "--output",
                "${workspaceFolder}/publish/net8.0"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "Publish (DLL net10.0)",
            "type": "process",
            "command": "dotnet",
            "args": [
                "publish",
                "${workspaceFolder}/ROP/ROP.fsproj",
                "--configuration",
                "Release",
                "--framework",
                "net10.0",
                "--output",
                "${workspaceFolder}/publish/net10.0"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "Publish (DLL, both frameworks)",
            "dependsOn": [
                "Publish (DLL net8.0)",
                "Publish (DLL net10.0)"
            ],
            "group": "build"
        },
        {
            "label": "Debug",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/Test/Test.fsproj",
                "--configuration",
                "Debug"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        }
    ]
}
