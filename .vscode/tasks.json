{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (Release)",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/ROP.sln",
                "--configuration",
                "Release"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Pack (NuGet)",
            "type": "process",
            "command": "dotnet",
            "args": [
                "pack",
                "${workspaceFolder}/ROP/ROP.fsproj",
                "--configuration",
                "Release",
                "--output",
                "${workspaceFolder}/nupkgs"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "Publish (DLL)",
            "type": "process",
            "command": "dotnet",
            "args": [
                "publish",
                "${workspaceFolder}/ROP/ROP.fsproj",
                "--configuration",
                "Release",
                "--output",
                "${workspaceFolder}/publish"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "Debug",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/Test/Test.fsproj",
                "--configuration",
                "Debug"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        }
    ]
}
