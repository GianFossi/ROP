<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Equipment.Core</RootNamespace>
    <!-- XML docs are being written progressively: do not warn on undocumented members yet. -->
    <NoWarn>$(NoWarn);FS3390</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Geometry.fs" />
    <Compile Include="Profile.fs" />
    <Compile Include="Part.fs" />
    <Compile Include="Issues.fs" />
    <Compile Include="TubeLayout.fs" />
    <Compile Include="Shapes.fs" />
    <Compile Include="Component.fs" />
    <Compile Include="Equipment.fs" />
    <Compile Include="Assembly.fs" />
    <Compile Include="Properties.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\ROP\ROP.fsproj" />
  </ItemGroup>
</Project>
